# ===============================
# Universal A2A Agent – .env.example
# ===============================

# Core LLM/provider used by the built-in examples (echo means “no external LLM”)
LLM_PROVIDER=echo

# Server
A2A_HOST=0.0.0.0
A2A_PORT=8000
PUBLIC_URL=http://localhost:8000

# Agent metadata
AGENT_NAME=Universal A2A Hello
AGENT_DESCRIPTION=Greets the user and echoes their message.
AGENT_VERSION=1.3.0
PROTOCOL_VERSION=0.3.0

# Private adapter (enterprise) — off by default
PRIVATE_ADAPTER_ENABLED=false        # true|false
PRIVATE_ADAPTER_AUTH_SCHEME=NONE     # NONE|BEARER|API_KEY
PRIVATE_ADAPTER_AUTH_TOKEN=
PRIVATE_ADAPTER_INPUT_KEY=input
PRIVATE_ADAPTER_OUTPUT_KEY=output
PRIVATE_ADAPTER_TRACE_KEY=traceId
PRIVATE_ADAPTER_PATH=/enterprise/v1/agent


# ---------------------------------------------------------------
# PATCH v1.3.0 — Big Docs /knowledge (RAG)  [OPTIONAL]
# ---------------------------------------------------------------
# This patch adds /knowledge endpoints for persistent retrieval
# over large Markdown files and full repositories.
# To enable, UNCOMMENT the lines you need below.

# --- Toggle the /knowledge router (off by default)
# A2A_ENABLE_KNOWLEDGE=1

# --- Index storage location (on the server filesystem)
# A2A_KNOWLEDGE_DIR=./.a2a_knowledge

# --- Chunking strategy (token-aware sizes; safe defaults)
# A2A_CHUNK_SIZE=1400
# A2A_CHUNK_OVERLAP=160
# A2A_INCLUDE_EXT=.md,.mdx,.py,.ipynb
# A2A_EXCLUDE_EXT=.png,.jpg,.jpeg,.gif,.pdf

# --- Vector DB selection
# A2A_VDB=chromadb                  # default in-process vector store

# (Optional) Qdrant for scale/HA
# A2A_VDB=qdrant
# A2A_QDRANT_URL=http://localhost:6333
# A2A_QDRANT_COLLECTION=a2a-knowledge

# --- Embeddings provider/model (CHOOSE ONE) --------------------
# NOTE: Some validators expect the generic EMBEDDINGS_* vars
# in addition to A2A_* vars. Both sets are provided here.

# (Option A) watsonx.ai embeddings
# A2A_EMBEDDINGS_PROVIDER=watsonx
# A2A_EMBEDDINGS_MODEL=ibm/slate-125m-english-rtrvr
# # Required for watsonx embeddings (set your own secrets/IDs):
# EMBEDDINGS_PROVIDER=watsonx
# EMBEDDINGS_MODEL_ID=ibm/slate-125m-english-rtrvr
# EMBEDDINGS_WATSONX_MODEL_ID=ibm/slate-125m-english-rtrvr
# EMBEDDINGS_WATSONX_URL=https://us-south.ml.cloud.ibm.com
# EMBEDDINGS_WATSONX_API_KEY=your-watsonx-api-key
# EMBEDDINGS_WATSONX_PROJECT_ID=your-watsonx-project-id

# (Option B) OpenAI embeddings
# A2A_EMBEDDINGS_PROVIDER=openai
# A2A_EMBEDDINGS_MODEL=text-embedding-3-small
# # Required for OpenAI embeddings:
# EMBEDDINGS_PROVIDER=openai
# EMBEDDINGS_MODEL_ID=text-embedding-3-small
# OPENAI_API_KEY=sk-...

# --- Clients & tests convenience (base URL to call the agent)
# A2A_BASE=http://localhost:8000

# --- CrewAI (optional) project-scoped memory directory
# CREWAI_STORAGE_DIR=.crewai_storage

# Notes:
# * /knowledge/ingest reads paths from the SERVER’S filesystem.
#   If the server runs in Docker, mount the repo path into that container.
# * With A2A_VDB=qdrant, ensure a Qdrant service is reachable at A2A_QDRANT_URL.
# * Uncomment exactly ONE embeddings provider block (watsonx OR OpenAI).
# * If your dotenv loader does not support ${VAR} expansion, set values directly.
